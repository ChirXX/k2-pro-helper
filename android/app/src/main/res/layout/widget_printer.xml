<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Принтер». RemoteViews понимает только простые View, поэтому никаких ConstraintLayout и своих классов. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_pic"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/widget_pic"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#FF9CA3A0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/w_upd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textColor="#FF6B7470"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_loading"
                android:textColor="#FFF2F5F3"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#FFC7CEC9"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/w_prog"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="5dp"
                android:max="1000"
                android:progressDrawable="@drawable/widget_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:textColor="#FF86EFAC"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_temps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#FFC7CEC9"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_buttons"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_refresh"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/widget_refresh"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#FFF2F5F3"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/w_light"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="💡"
            android:textColor="#FFF2F5F3"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_pause"
            android:textColor="#FFF2F5F3"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_cam"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_acc"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_cam"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
